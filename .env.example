# ===== Telegram =====
# Create a bot with @BotFather, then get your chat id with: python main.py chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_TELEGRAM=true

# ===== Market data =====
# Optional. TwelveData gives clean forex/stock intraday candles.
# Get a free key at https://twelvedata.com/pricing
# Without it the bot still works for all markets via Yahoo Finance.
TWELVEDATA_API_KEY=

# ===== Trading universe =====
# Comma separated. Crypto, forex and stocks can be mixed freely.
CTB_SYMBOLS=BTC/USD,ETH/USD,EUR/USD,AAPL
CTB_BASE_INTERVAL=5m
CTB_HIGHER_INTERVAL=15m
CTB_STRATEGY=adaptive

# ===== Engine =====
CTB_POLL_SECONDS=20
CTB_MIN_CONFIDENCE=62
CTB_DEDUP_TTL_MINUTES=120
CTB_CACHE_TTL_SECONDS=15
CTB_REQUEST_TIMEOUT=15
CTB_DB_PATH=ctb_state.db
CTB_LOG_LEVEL=INFO
CTB_DRY_RUN=false

# ===== Risk (used for position sizing / paper trades) =====
CTB_ACCOUNT_BALANCE=1000
CTB_RISK_PER_TRADE_PCT=1.0
CTB_SL_ATR_MULT=1.5
CTB_TP_ATR_MULT=2.5
